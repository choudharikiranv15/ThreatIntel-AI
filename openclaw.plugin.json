{
  "id": "threatintel-ai-engine",
  "name": "ThreatIntel AI Engine",
  "description": "Evidence-first threat intelligence investigation tools. Currently supports CVE investigations using NVD and CISA KEV.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "nvdApiKey": {
        "type": "string",
        "description": "Optional NVD API key."
      },
      "requestTimeoutMs": {
        "type": "number",
        "description": "HTTP request timeout in milliseconds.",
        "default": 15000
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "threatintel_investigate"
    ]
  },
  "toolMetadata": {
    "threatintel_investigate": {
      "profiles": [
        "coding",
        "full"
      ]
    }
  }
}
