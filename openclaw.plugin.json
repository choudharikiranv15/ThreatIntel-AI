{
  "id": "threatintel-ai-engine",
  "name": "ThreatIntel AI Engine",
  "description": "Evidence-first threat intelligence investigation engine. Currently supports CVE investigations using NVD and CISA KEV, plus retrieval of previously persisted investigation context.",
  "version": "0.2.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "nvdApiKey": {
        "type": "string",
        "description": "Optional NVD API key."
      },
      "requestTimeoutMs": {
        "type": "number",
        "description": "HTTP request timeout in milliseconds.",
        "default": 15000,
        "minimum": 1000,
        "maximum": 60000
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "threatintel_investigate",
      "threatintel_prior_investigation"
    ]
  },
  "toolMetadata": {
    "threatintel_investigate": {
      "profiles": [
        "coding"
      ]
    }
  }
}
