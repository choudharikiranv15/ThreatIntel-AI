{
  "name": "threatintel-ai-engine",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first CVE investigation tool for ThreatIntel AI on OpenClaw.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "validate": "openclaw plugins validate --entry ./dist/index.js",
    "test": "npm run build && npm run test:contract && npm run test:correlation && npm run test:accuracy && npm run test:faults && npm run test:validation && npm run test:provenance && npm run test:timestamps && npm run test:redhat && npm run test:policy && npm run test:service && npm run test:verification && npm run test:verification:integration && npm run test:reference-provenance",
    "test:database": "npm run test:db && npm run test:persistence && npm run test:history && npm run test:context && npm run test:prior && npm run test:rollback && npm run test:integrity && npm run test:concurrency && npm run test:replay && npm run test:diff",
    "test:live": "npm run test:cve && npm run test:redhat:golden && npm run test:live:correlation",
    "test:live:correlation": "node ./dist/test-live-correlation.js",
    "test:correlation": "node ./dist/test-correlation.js",
    "test:diff": "node ./dist/persistence/test-investigation-diff.js",
    "test:accuracy": "node ./dist/test-engine-accuracy.js",
    "replay": "node ./dist/persistence/replay-cli.js",
    "test:contract": "node ./dist/test-plugin-contract.js",
    "test:replay": "node ./dist/persistence/test-replay.js",
    "test:cve": "node ./dist/test-golden.js",
    "test:faults": "node ./dist/test-faults.js",
    "test:validation": "node ./dist/test-validation.js",
    "test:provenance": "node ./dist/test-provenance.js",
    "test:timestamps": "node ./dist/test-timestamps.js",
    "test:redhat": "node ./dist/sources/test-redhat.js",
    "test:redhat:golden": "node ./dist/sources/test-redhat-golden.js",
    "test:db": "node ./dist/persistence/test-db.js",
    "test:persistence": "node ./dist/persistence/test-persistence.js",
    "test:history": "node ./dist/persistence/test-investigation-history.js",
    "test:context": "node ./dist/persistence/test-investigation-context.js",
    "test:prior": "node ./dist/persistence/test-investigation-prior.js",
    "test:policy": "node ./dist/persistence/test-investigation-policy.js",
    "test:verification": "node ./dist/verification/verify-claim.test.js",
    "test:verification:integration": "node ./dist/verification/test-engine-integration.js",
    "test:service": "node ./dist/persistence/test-investigation-service.js",
    "test:rollback": "node ./dist/persistence/test-rollback.js",
    "test:integrity": "node ./dist/persistence/test-cross-investigation.js",
    "test:concurrency": "node ./dist/persistence/test-concurrency.js",
    "test:reference-provenance": "node ./dist/reference-provenance.test.js"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "pg": "^8.23.0",
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "openclaw": "^2026.7.1-2",
    "typescript": "^5.9.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
